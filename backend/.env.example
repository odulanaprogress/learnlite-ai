# LearnLite Backend Environment Configuration

PORT=4000
NODE_ENV=development

# Python AI Service endpoint
AI_SERVICE_URL=http://localhost:8000

# CORS settings for frontend (Cloudflare Pages or localhost)
CORS_ORIGIN=*

# Maximum file upload size in MB (must match or be lower than AI service max_upload_size_mb)
MAX_FILE_SIZE_MB=15

# Authentication & JWT Configuration
JWT_SECRET=learnlite-dev-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
DATA_DIR=./data
